<div class="blog-container">
  {{#if projects.length}}
    {{#each projects}}
    <div class="blog-post">
      <div class="post-title">
        <a href="/project/{{id}}">{{title}}</a>
        <span class="post-meta">Posted by {{user.username}} on {{format_date createdAt}}</span>
      </div>
      <div class="post-content">
        {{content}}
      </div>
    </div>
    {{/each}}
  {{else}}
    <div class="blog-post">
      <div class="post-title">
        Welcome to Tech-Blog
      </div>
      <div class="post-content">
        There are no posts created yet. {{#unless logged_in}}<a href="/login">Login</a>{{/unless}} to create a post!
      </div>
    </div>
  {{/if}}
</div>